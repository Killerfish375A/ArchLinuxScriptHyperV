table inet filter {
  chain output {
    type filter hook output priority 0;

    # allow localhost
    oif "lo" accept

    # allow VPN interface
    oif "proton" accept

    # block everything else
    reject
  }

  chain input {
    type filter hook input priority 0;
    iif "lo" accept
    iif "proton" accept
    reject
  }
}
